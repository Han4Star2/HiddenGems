# Signiert die Session-Cookie (HMAC). In Produktion unbedingt setzen.
SESSION_SECRET=

# Roblox OAuth-App aus https://create.roblox.com/dashboard/credentials
# Redirect-URI: <origin>/api/auth/roblox/callback, Scopes: openid profile
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Premium wird über Besitz dieses Gamepasses (und/oder T-Shirts) freigeschaltet,
# nicht über Echtgeld-Zahlung auf der Website.
PREMIUM_GAMEPASS_ID=
PREMIUM_TSHIRT_ID=

# Schützt POST /api/games/submit und /api/games/refresh vor öffentlichem
# Zugriff (als "x-ingest-secret"-Header mitschicken). Beliebiger langer
# Zufallsstring, z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=
